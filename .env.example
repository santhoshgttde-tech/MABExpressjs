# ============================================================================
# Supabase production configuration for the Voucher Approval API
# Copy to .env (or set these as secrets on Render/Railway/Fly).
# NEVER commit the real values.
# ============================================================================

# ----- Server ---------------------------------------------------------------
PORT=10000
NODE_ENV=production

# ----- Supabase PostgreSQL --------------------------------------------------
# From the Supabase dashboard:
#   Project Settings -> Database -> Connection strings
#
# RECOMMENDED for the running API: the TRANSACTION POOLER connection.
#   postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# Alternatives:
#   Session pooler   : ...@aws-0-<region>.pooler.supabase.com:5432/postgres
#   Direct           : postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres
#
# If your database password contains special characters (@ : / ? & # % =),
# URL-encode them here or set DATABASE_* components below instead.
DATABASE_URL=postgresql://postgres.project-ref:db-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase requires TLS. True works for pooler and direct connections.
DATABASE_SSL=true

# Optional: instead of DATABASE_URL you may provide components (local dev etc.)
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=erp
# DATABASE_USER=postgres
# DATABASE_PASSWORD=

# Pool sizing (keep modest so the pooler/direct connection budget is respected)
# PGPOOL_MAX=10
# PGPOOL_MIN=0
# PG_CONNECT_TIMEOUT_MS=10000

# ----- JWT (YOUR OWN, for the Express API) ----------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# This is NOT Supabase's anon/service_role key and NOT Supabase's JWT secret.
JWT_SECRET=replace-with-a-96-hex-character-random-string
JWT_EXPIRES_IN=1d

# ----- Application ------------------------------------------------------------
# Business day/timezone for voucher summaries. Must match your region.
APP_TIMEZONE=Asia/Kolkata

# ----- CORS ------------------------------------------------------------------
# Native mobile apps send no Origin header and are unaffected by CORS.
# Set this to your web dashboard URL(s), comma-separated. '*' allows any origin.
ALLOWED_ORIGINS=*

# ----- Rate limiting ------------------------------------------------------------
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=20
API_RATE_WINDOW_MS=900000
API_RATE_MAX=500